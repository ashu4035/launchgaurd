# Local development: credentials remain on the backend.
WEBFLOW_SITE_API_TOKEN=
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:1337
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
FRONTEND_ORIGIN=http://localhost:5173
LAUNCHGUARD_DB=./data/launchguard.json
# OAuth callback is PUBLIC_BASE_URL/auth/callback.
